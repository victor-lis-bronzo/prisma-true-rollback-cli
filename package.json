{
  "name": "prisma-true-rollback-cli",
  "version": "0.1.0",
  "description": "A CLI (invoked via npx) that performs a true, destructive rollback of the most recently applied Prisma migration in development environments.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "prisma-true-rollback": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test"
  },
  "keywords": [
    "prisma",
    "migration",
    "rollback",
    "cli",
    "database"
  ],
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "mysql2": "^3.24.4",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "author": "Victor Lis Bronzo",
  "homepage": "https://github.com/victor-lis-bronzo/prisma-true-rollback-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-lis-bronzo/prisma-true-rollback-cli.git"
  },
  "bugs": {
    "url": "https://github.com/victor-lis-bronzo/prisma-true-rollback-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
